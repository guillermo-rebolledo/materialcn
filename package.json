{
  "name": "materialcn",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --config vite.lib.config.ts",
    "build:playground": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "tokens": "node scripts/generate-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "registry": "node scripts/generate-registry.mjs",
    "registry:build": "pnpm registry && shadcn build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:registry": "vitest run --project scripts",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.33.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "oxlint": "^1.75.0",
    "playwright": "latest",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.0",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "latest"
  },
  "license": "MIT",
  "description": "A React component library with Material 3 Expressive design, built on shadcn/ui.",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.stories.tsx",
    "!src/**/*.mdx",
    "components.json",
    "registry.json",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.css.ts",
      "default": "./dist/styles.css"
    },
    "./tokens/*": "./src/styles/tokens/*",
    "./package.json": "./package.json",
    "./fonts.css": {
      "types": "./src/styles/fonts.d.css.ts",
      "default": "./src/styles/fonts.css"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "keywords": [
    "react",
    "component-library",
    "material-design",
    "material-3",
    "m3",
    "shadcn",
    "shadcn-ui",
    "tailwind",
    "tailwindcss",
    "base-ui",
    "design-system",
    "ui-components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillermo-rebolledo/materialcn.git"
  },
  "bugs": {
    "url": "https://github.com/guillermo-rebolledo/materialcn/issues"
  },
  "homepage": "https://guillermo-rebolledo.github.io/materialcn/",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
